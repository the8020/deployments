{
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "useUnknownInCatchVariables": true,
    "lib": [
      "deno.ns",
      "dom",
      "dom.iterable",
      "esnext"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.14"
  },
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check types.ts src/*.ts tables/*.ts programs/*/*.ts services/*/*.ts",
    "test": "deno test --allow-read --allow-write --allow-net --allow-run=git .",
    "test:browser": "deno run -A ../uui/presentation_browser_e2e.ts --fixture=../deployments/src/screens_browser.ts"
  }
}
